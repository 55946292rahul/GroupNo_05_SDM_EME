      "PatientRegistrationDto": {
        "required": [
          "aadharNo",
          "areaid",
          "bloodGrp",
          "dob",
          "emailAddress",
          "fname",
          "gender",
          "lname",
          "mobNo",
          "pAddress",
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "fname": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "lname": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "emailAddress": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "aadharNo": {
            "minLength": 1,
            "pattern": "^\\d{12}$",
            "type": "string"
          },
          "pAddress": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "gender": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string"
          },
          "bloodGrp": {
            "maxLength": 3,
            "minLength": 0,
            "type": "string"
          },
          "dob": {
            "type": "string",
            "format": "date"
          },
          "areaid": {
            "type": "integer",
            "format": "int32"
          },
          "mobNo": {
            "minLength": 1,
            "pattern": "^\\d{10}$",
            "type": "string"
          },
          "username": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "maxLength": 100,
            "minLength": 6,
            "type": "string"
          }
        },
        "additionalProperties": false
